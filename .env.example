# Copy to .env and adjust. Never commit real secrets (PRD §37).
PORT=8080
ENV=development
LOG_LEVEL=info

# Dashboard origins allowed to call the API from a browser (comma-separated).
# Defaults to the Vite dev server. Use "*" only for throwaway local setups.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (required)
DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhook_engine?sslmode=disable

# Redis (optional; endpoint rate limiting is disabled when unset)
REDIS_URL=redis://localhost:6379/0

# JWT auth (required)
JWT_SECRET=change-me-to-a-256-bit-random-secret
JWT_EXPIRATION=12h

# Worker pool
WORKER_COUNT=10
QUEUE_SIZE=1000

# Delivery
REQUEST_TIMEOUT=10s
MAX_RESPONSE_BYTES=65536
MAX_REQUEST_BODY_BYTES=1048576
# true only for local development/tests: skips SSRF checks for private URLs
ALLOW_PRIVATE_URLS=false

# Retry policy
MAX_RETRIES=7
INITIAL_RETRY_DELAY=5s
MAX_RETRY_DELAY=15m
BACKOFF_MULTIPLIER=2
JITTER_FRACTION=0.25

# Status classification (configurable, PRD §17)
RETRYABLE_STATUS_CODES=408,429,500,502,503,504
PERMANENT_STATUS_CODES=400,401,403,404,410

# Rate limiting
DEFAULT_RATE_LIMIT=100
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_BURST_FACTOR=1.0

# Dispatcher
DISPATCHER_INTERVAL=1s
CLAIM_BATCH_SIZE=64
STALE_PROCESSING_TIMEOUT=2m
ENDPOINT_CONCURRENCY=1

# Migrations
MIGRATIONS_DIR=migrations
